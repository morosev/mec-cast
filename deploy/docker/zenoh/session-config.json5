// Zenoh session configuration for mec-cast ROS2 nodes (rmw_zenoh).
// Point ZENOH_SESSION_CONFIG_URI at this file. Nodes dial the router by
// service name; multicast scouting is off (models the 5G/UPF path where
// multicast does not exist).
//
// IMPORTANT: rmw_zenoh loads this with zenoh::Config::from_file(), which
// REPLACES its packaged default config outright — nothing merges. rmw_zenoh
// tunings we rely on must be restated here or they silently revert to
// zenoh's own defaults. (ZENOH_CONFIG_OVERRIDE merges; this file does not.)
{
  mode: "peer",
  // Reliable UDP (`rel=1`) — Zenoh's UDP link plus Zenoh transport-level
  // reliability. Not QUIC, and not encrypted. Must match the router's
  // scheme and flags exactly, or the peer never establishes a link.
  // See ADR-0006.
  connect: {
    endpoints: ["udp/zenoh-router:7447?rel=1"],
  },
  // Shared memory is deliberately OFF.
  //
  // Two reasons. It crashes where /dev/shm is small: a container gets 64 MB
  // by default, and on a constrained runner the provider fails to allocate
  // (ENOMEM), which aborts rclpy.init() and kills the node at startup.
  //
  // The stronger reason is measurement integrity. SHM is a same-host
  // transport optimisation, and every path this platform measures crosses a
  // network boundary — container to container locally, UE to edge over 5G in
  // the lab. If SHM ever did engage between two co-located processes it
  // would bypass the very path under measurement and silently report
  // latencies that no deployment would ever see.
  transport: {
    shared_memory: { enabled: false },
    // Match the router: rmw_zenoh's 60 s lease / keep_alive 2 rather than
    // zenoh's 10 s / 4. Both ends of a link negotiate down to the smaller
    // lease, so restating it only here or only on the router is not enough.
    link: {
      tx: {
        lease: 60000,
        keep_alive: 2,
      },
    },
  },
  scouting: {
    multicast: { enabled: false },
  },
  // rmw_zenoh enables timestamping everywhere, zenoh's peer default is off.
  // HLC stamps on samples are what dedup/ordering will lean on once routers
  // peer across cells.
  timestamping: {
    enabled: { router: true, peer: true, client: true },
  },
}
