// Zenoh router configuration for the mec-cast lab topology.
// The router is the rendezvous point; peers dial it explicitly (no
// multicast scouting — it would not traverse a UPF/NAT anyway).
//
// IMPORTANT: rmw_zenoh loads this with zenoh::Config::from_file(), which
// REPLACES its packaged default config outright — nothing merges. Every
// rmw_zenoh tuning we care about must therefore be restated here, or it
// silently reverts to zenoh's own default. The keys below under `adminspace`,
// `transport.link.tx` and `routing` exist for exactly that reason.
// (ZENOH_CONFIG_OVERRIDE is different: it merges, via insert_json5().)
{
  mode: "router",
  // rmw_zenoh ships adminspace ON for routers; losing it to the file-replace
  // semantics cost us @/<zid>/router/** introspection — the very thing needed
  // to verify transports when the edge-to-edge mesh arrives.
  adminspace: {
    enabled: true,
    permissions: { read: true, write: false },
  },
  // Reliable UDP (`rel=1`): Zenoh's own UDP link, with Zenoh's transport
  // reliability (sequence numbers and retransmission) layered above it.
  //
  // This is NOT QUIC. The link is handled by `zenoh_link_udp`; the `quic/`
  // scheme is a separate implementation and requires TLS. There is no
  // network congestion control here — only the per-queue drop/block policy
  // under transport.link.tx.queue.congestion_control — and no encryption.
  //
  // Chosen over TCP because it measured equal or better on p99 and jitter
  // with identical loss, and because TCP's congestion collapse under random
  // loss is the failure this platform kept hitting. See ADR-0006.
  listen: {
    // quic/ is NOT here on purpose. It needs TLS material that
    // scripts/gen-dev-tls.sh generates into a gitignored directory, so a
    // fresh checkout has none -- and zenoh treats a failed listener as FATAL.
    // Listing it by default killed the whole router in CI, taking these two
    // working listeners with it, and every node then died unable to resolve
    // the container that had just exited. Enable it per deployment instead;
    // see docs/operations/lab-topology.md.
    endpoints: ["udp/[::]:7447?rel=1", "tcp/[::]:7448"],
  },
  // Shared memory is deliberately OFF.
  //
  // Two reasons. It crashes where /dev/shm is small: a container gets 64 MB
  // by default, and on a constrained runner the provider fails to allocate
  // (ENOMEM), which aborts rclpy.init() and kills the node at startup.
  //
  // The stronger reason is measurement integrity. SHM is a same-host
  // transport optimisation, and every path this platform measures crosses a
  // network boundary — container to container locally, UE to edge over 5G in
  // the lab. If SHM ever did engage between two co-located processes it
  // would bypass the very path under measurement and silently report
  // latencies that no deployment would ever see.
  transport: {
    shared_memory: { enabled: false },
    // rmw_zenoh's packaged values (60 s lease, keep_alive 2). The zenoh
    // defaults this file was silently reverting to are 10 s / 4 — a session
    // that drops after 10 quiet seconds is the wrong trade for a robot that
    // may legitimately pause between runs.
    link: {
      tls: {
        listen_certificate: "/zenoh/tls/router.crt",
        listen_private_key: "/zenoh/tls/router.key",
        root_ca_certificate: "/zenoh/tls/ca.crt",
      },
      tx: {
        lease: 60000,
        keep_alive: 2,
      },
    },
  },
  // QUIC mandates TLS 1.3; there is no unencrypted quic/ endpoint. The
  // material is generated by scripts/gen-dev-tls.sh and gitignored -- the
  // server cert MUST carry basicConstraints CA:FALSE or zenoh's TLS stack
  // rejects it as CaUsedAsEndEntity, and its SAN must cover every name a
  // client dials.
  //
  // Worth knowing for later: zenoh 1.9 reimplements udp/?rel=1 as QUIC
  // WITHOUT TLS, so this same transport becomes available with no
  // certificates once rmw_zenoh's jazzy branch moves past 1.8.
  scouting: {
    multicast: { enabled: false },
  },
  routing: {
    router: {
      // rmw_zenoh ships false; the zenoh default is true. Pinned explicitly
      // because it only matters with gossip + peers targeting routers, and
      // an implicit value that changes by which config file loaded is worse
      // than either choice. (Removed upstream in zenoh 1.9 — do not build
      // on it.)
      peers_failover_brokering: false,
    },
  },
  // rmw_zenoh enables timestamping everywhere, zenoh's default is router-only.
  // HLC timestamps on samples are what make dedup and ordering possible once
  // routers peer, and they cost nearly nothing.
  timestamping: {
    enabled: { router: true, peer: true, client: true },
  },
}
