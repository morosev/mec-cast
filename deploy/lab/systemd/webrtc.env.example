# /etc/mec-cast/webrtc.env: the environment of mec-cast-webrtc@<config>.
# KEY=value lines, no `export`, comments on their own lines.

# The checkout the client was built in.
MEC_CAST_DIR=/home/ops/mec-cast
# Where the client writes runs/: an absolute path (systemd does not expand
# ${MEC_CAST_DIR} here).
RUNS_DIR=/home/ops/mec-cast/runs

# The admin, which starts and stops the client's runs; and the logging service.
ADMIN_URL=ws://10.0.0.10:8099/ws/node
LOGGING_URL=http://10.0.0.10:8000

# Optional.
#ZONE=zone-a
# node from nvm is not on systemd's PATH: name it.
#NODE=/home/ops/.nvm/versions/node/v20.18.0/bin/node
