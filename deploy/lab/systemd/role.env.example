# /etc/mec-cast/<role>.env: what mec-cast-role@<role> starts the role with.
# The same variables deploy.sh forwards, set as for that role's deploy.
# systemd reads KEY=value lines: no `export`, and a comment only on a line
# of its own -- after a value it would become part of the value.

# The checkout deploy.sh rsyncs to (its ~/mec-cast, spelled out in full).
MEC_CAST_DIR=/home/ops/mec-cast

# The middleware, the same on every host; COMPOSE_PROFILES must equal it,
# as deploy.sh sets it, for the edge to start its router or discovery server.
MIDDLEWARE=zenoh
COMPOSE_PROFILES=zenoh
MIDDLEWARE_LINK=tcp

# Every role.
INFRA_HOST=10.0.0.10
# ue, gnb.
EDGE_HOST=10.0.0.20

# Optional, as in docs/operations/deploy-manual.md: ZONE, PTP_DEVICE,
# DDS_INTERFACES (dds), CODEC, PATTERN, DATASET, RELAY_PUBLIC_IP (relay)...
#ZONE=zone-a
#RELAY_PUBLIC_IP=10.45.0.1

# No RUN_ID: under the admin the nodes wait for a run. A node started at
# every boot under one fixed RUN_ID would append each boot to that run.
