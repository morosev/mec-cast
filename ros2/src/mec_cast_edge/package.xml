<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mec_cast_edge</name>
  <version>0.1.0</version>
  <description>mec-cast MEC edge subscriber: stamps arrivals, processes point clouds, records latency metrics.</description>
  <maintainer email="morosev@gmail.com">morosev</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>mec_cast_msgs</depend>
  <depend>mec_cast_admin_client</depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>mec_cast_lidar_client</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
