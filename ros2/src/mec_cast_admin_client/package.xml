<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mec_cast_admin_client</name>
  <version>0.1.0</version>
  <description>Admin control-plane client shared by the mec-cast ROS2 nodes: subscribes to the admin service over WebSocket, reports status, and delivers commands to the node's executor thread.</description>
  <maintainer email="morosev@gmail.com">morosev</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <!-- websockets >= 12 for the synchronous client API. The apt package is
       10.4, so the image installs it with pip; see deploy/docker/ros.Dockerfile. -->
  <exec_depend>python3-websockets</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
