<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mec_cast_render</name>
  <version>0.1.0</version>
  <description>mec-cast UE-side renderer: draws the edge's processed cloud and measures the PTP-free round trip.</description>
  <maintainer email="morosev@gmail.com">morosev</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>mec_cast_msgs</depend>
  <depend>mec_cast_admin_client</depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
