# Keep the docker build context small: only telemetry/, ran/, ros2/, deploy/ matter.
# third_party/webrtc alone is ~20 GB — it must never enter a build context.
.git/
third_party/
# ...except the G-PCC codec, which the ROS image builds (ADR-0014). Its build
# directories, if any were made in the checkout, stay out.
!third_party/mpeg-pcc-tmc13/
# ...and str0m, which the media relay image builds against.
!third_party/str0m/
third_party/str0m/target/
third_party/mpeg-pcc-tmc13/build*/
clients/
edge/signaling/
services/
scripts/
tests/
tools/
docs/
target/
runs/
**/.venv/
**/__pycache__/
**/node_modules/

# Development TLS material: mounted at runtime, never baked into an image.
deploy/docker/zenoh/tls/
