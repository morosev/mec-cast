# Build artifacts
clients/webrtc_native/build/
target/
runs/

# Per-developer local tool config
.claude/settings.local.json

# Per-run shell environment sourced into each terminal when operating the
# system by hand (docs/guides/manual-operation.md). Holds one RUN_ID.
.run-env

# Editor-extension AI instruction files (e.g. the Mermaid Chart VS Code
# extension writes these). Deliberately not tracked: they would impose that
# extension on everyone who clones, and their guidance competes with
# docs/diagrams/render.sh, which validates and renders without an editor.
# These two rules are path-specific, so .github/workflows/ stays tracked.
.github/copilot-instructions.md
.github/instructions/

# Vector renders of the Mermaid diagrams. PNG is committed because that is
# what GitHub can display; SVG is only needed for print or a paper and is
# regenerated on demand with `bash docs/diagrams/render.sh --svg`.
docs/diagrams/*.svg

# Python
__pycache__/
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Dependencies
node_modules/

# Logs
clients/webrtc_native/log/
edge/signaling/log/

# ROS2 colcon output (built inside containers, never committed)
ros2/build/
ros2/install/
ros2/log/

# WebRTC build output and tools (managed separately by gclient)
third_party/webrtc/src/out/
third_party/webrtc/depot_tools/
third_party/webrtc/.cipd/
third_party/webrtc/.gclient
third_party/webrtc/.gclient_entries
third_party/webrtc/.gclient_previous_sync_commits
third_party/webrtc/.gcs_entries
third_party/webrtc/_bad_scm/

# Written on lab hosts by deploy/lab/deploy.sh (rsync deploys have no .git)
.deployed-version

# macOS Finder metadata. Finder writes one into any directory it browses, so
# this needs to match at every depth — which a pattern containing no slash
# already does, unlike the fixed paths above.
.DS_Store
